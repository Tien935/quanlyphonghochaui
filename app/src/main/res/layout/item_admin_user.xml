<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/haui_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/haui_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAdminUserName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/haui_blue"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Nguyễn Văn A" />

            <TextView
                android:id="@+id/tvAdminUserRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/haui_text"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="SINH VIÊN" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvAdminUserCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:textColor="@color/haui_text"
            android:textSize="14sp"
            tools:text="Mã HaUI: 2021601234" />

        <TextView
            android:id="@+id/tvAdminUserEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/haui_text"
            android:textSize="14sp"
            tools:text="Email: student@haui.edu.vn" />

        <TextView
            android:id="@+id/tvAdminUserCreated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:textColor="@color/haui_text_muted"
            android:textSize="13sp"
            tools:text="Ngày tạo: 16/08/2026 08:30" />

        <TextView
            android:id="@+id/tvAdminUserLastSignIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/haui_text_muted"
            android:textSize="13sp"
            tools:text="Đăng nhập gần nhất: 16/08/2026 15:45" />

        <TextView
            android:id="@+id/tvAdminUserStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Đang hoạt động" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdminUserLockAction"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/lock_account"
            android:textAllCaps="false"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>