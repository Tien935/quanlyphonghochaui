<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/roomManagementRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/haui_surface"
    android:orientation="vertical"
    tools:context=".RoomManagementActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/haui_blue"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRoomManagementBack"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:icon="@drawable/ic_arrow_back_24"
            app:iconTint="@color/white" />


        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/admin_manage_rooms"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:text="@string/admin_room_description"
        android:textColor="@color/haui_text_muted"
        android:textSize="14sp" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        android:hint="@string/admin_room_search_hint"
        app:boxStrokeColor="@color/haui_blue">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAdminRoomSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:hint="@string/status_filter"
            app:boxStrokeColor="@color/haui_blue">

            <AutoCompleteTextView
                android:id="@+id/actAdminRoomStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefreshAdminRooms"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="@string/refresh"
            android:textAllCaps="false"
            android:textColor="@color/haui_blue"
            app:cornerRadius="12dp"
            app:strokeColor="@color/haui_blue" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddAdminRoom"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="14dp"
        android:text="@string/add_room"
        android:textAllCaps="false"
        android:textStyle="bold"
        app:backgroundTint="@color/haui_blue"
        app:cornerRadius="12dp" />

    <TextView
        android:id="@+id/tvAdminRoomCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="18dp"
        android:text="@string/admin_room_loading"
        android:textColor="@color/haui_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/adminRoomProgress"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="18dp"
        android:indeterminate="true"
        app:indicatorColor="@color/haui_yellow"
        app:trackColor="@color/haui_outline" />

    <TextView
        android:id="@+id/tvAdminRoomState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="24dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/haui_text_muted"
        android:textSize="15sp"
        android:visibility="gone"
        tools:text="Không có phòng học phù hợp."
        tools:visibility="visible" />

    <ListView
        android:id="@+id/listAdminRooms"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@null"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="20dp"
        android:scrollbars="vertical" />

</LinearLayout>